# ===== 服务监听 =====
# 默认仅本机可达（loopback）。容器/生产如需对外监听改为 0.0.0.0，
# 必须同时设置 bearer token、显式 CORS origins 与真实 audit log path，
# 否则服务会拒绝启动。
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info
APP_LOG_FORMAT=pretty   # pretty | json

# ===== 安全 =====
# bearer token：绑定到非 loopback（如 0.0.0.0）时必填，否则硬失败拒绝启动；
# loopback 本机调试可留空（所有端点无鉴权开放，仅限可信本机）。
APP_SECURITY__AUTH_TOKEN=
# 审计中的可信操作员标签（仅服务端配置可写）；真实 actor 会同时附带不可逆 token 指纹。
APP_SECURITY__AUTH_ACTOR_LABEL=operator
# 高风险操作审计日志路径（JSONL）；非 loopback 必填，默认写入被 git 忽略的本地运行目录。
APP_SECURITY__AUDIT_LOG_PATH=security_audit.jsonl
# CORS 白名单使用 JSON/TOML 数组语法；环境变量优先于 config.toml。
# 空列表或 "*" 仅适合 loopback dev；生产/容器部署未显式配置会拒绝启动。
APP_SECURITY__ALLOWED_ORIGINS=["http://127.0.0.1:8080"]
# auth_exempt_paths 只允许 /health、/metrics、/api/metrics；不要豁免 /api 或交易端点。

# ===== API 暴露面（非主线 router gate）=====
# 主线 P0 router 始终暴露；以下辅助 router 可关闭以缩小攻击面与 DTO 漂移面。
# 默认：当前主工作台未消费的 legacy/diagnostic/helper 关闭。
APP_API_SURFACE__CHAT=false             # /api/chat*（当前主工作台未消费）
APP_API_SURFACE__LLM_DIAGNOSTICS=false  # /api/llm/*（无前端引用，诊断）
APP_API_SURFACE__OPTIONS=false          # /api/options/*（当前主工作台未消费）
APP_API_SURFACE__WATCHLIST_ALERTS=false # /api/watchlist* 与 /api/alerts/rules*（观察/告警支撑面）
APP_API_SURFACE__SPOT_V1=false          # /api/v1/spot/*（无前端引用，旧版）
APP_API_SURFACE__STRATEGY_V1=false      # /api/v1/strategy/*（旧诊断；主工作台使用 /api/strategy/main-kinds）

# ===== Redis (可选) =====
REDIS_URL=redis://127.0.0.1:6379

# ===== 链上/CEX 只读比较 =====
# Jupiter 可使用官方 keyless 低频额度；配置 key 后提高额度并支持高效 token registry 查询。
# EVM 可在 0x 与 OKX DEX Aggregator V6 间选择；OKX 使用独立 Onchain OS 项目凭证。
# 自定义 EVM HTTPS RPC 从链上套利界面写入后端内存，只核验 chainId / blockNumber，永不回显 URL。
# 系统不传 taker，不连接钱包，不签名、不授权、不广播。
JUPITER_API_KEY=
ZEROX_API_KEY=
OKX_DEX_API_KEY=
OKX_DEX_SECRET_KEY=
OKX_DEX_PASSPHRASE=

# Backpack 股票 RFQ：同一组 Base64 API 公钥与 32 字节 Secret seed。
# 可在股票模块或设置保存；仅点击询价/核对/取消时使用，不会自动接受报价。
BACKPACK_STOCK_API_KEY=
BACKPACK_STOCK_SECRET_KEY=

# ===== 交易所凭证 (公共行情可不填；Live 只校验当前 HedgeTicket 双腿涉及的交易所) =====
# 凭证 backend：keychain（macOS 加密，桌面推荐）| runtime（容器/临时会话）|
# env_file（仅兼容受控本机，会把凭证明文写入 .env，不建议长期 Live 使用）。
APP_CREDENTIALS__SECRET_BACKEND=keychain

BINANCE_API_KEY=
BINANCE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# OKX Live（仅凭证配置；实际是否可交易由双腿 HedgeTicket preflight 判断）
OKX_LIVE_API_KEY=
OKX_LIVE_API_SECRET=
OKX_LIVE_PASSPHRASE=
# 执行账本 JSONL 基础持久化；用于重启后回放已入账的订单状态、撤单与成交事实。
APP_STORAGE__EXECUTION_LEDGER_PATH=execution_ledger.jsonl
# 留空时默认使用系统固定数据目录：
# macOS: ~/Library/Application Support/crossline-omni
# Linux: ~/.local/share/crossline-omni 或 $XDG_DATA_HOME/crossline-omni
APP_STORAGE__DATA_DIR=
APP_STORAGE__PORTFOLIO_NAV_PATH=portfolio_nav.sqlite
APP_STORAGE__WATCHLIST_ALERTS_PATH=watchlist_alerts.sqlite
APP_STORAGE__EXECUTION_RUN_LEDGER_PATH=execution_runs.jsonl
APP_STORAGE__ORDER_SNAPSHOT_PATH=order_snapshots.jsonl
APP_STORAGE__CLOSE_RUN_LEDGER_PATH=close_runs.jsonl

BYBIT_API_KEY=
BYBIT_API_SECRET=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

GATE_API_KEY=
GATE_API_SECRET=

# Gate CrossEx 使用独立凭证；不能复用普通 Gate Spot/Futures Key。
GATE_CROSSEX_API_KEY=
GATE_CROSSEX_API_SECRET=

# Kraken Spot 与 Futures 权限和签名域独立；至少填写一组完整 Key/Secret。
KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_API_SECRET=
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# Hyperliquid: Account Address 是真实交易账户地址；Private Key 是 API/Agent wallet 私钥。
# 不要把 Agent wallet 地址填成 Account Address，否则余额/持仓会查错账户。
HYPERLIQUID_ACCOUNT_ADDRESS=
# 兼容旧配置；新配置请使用 HYPERLIQUID_ACCOUNT_ADDRESS。
HYPERLIQUID_USER_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# ===== 可选 legacy / 非 P0 扩展凭证（默认 router 关闭）=====
# DERIBIT_CLIENT_ID=
# DERIBIT_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
