# syntax=docker/dockerfile:1.7
# 阶段 1：用 Rust + Trunk + Node 构建 WASM + Tailwind
ARG RUST_VERSION=1.95
FROM rust:${RUST_VERSION}-slim-bookworm AS builder
WORKDIR /build

ARG CARGO_BUILD_JOBS=2
ARG TRUNK_VERSION=0.21.14
ARG TARGETARCH
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS} \
    CARGO_INCREMENTAL=0

# 系统依赖：node（Tailwind 编译用）+ pkg-config + openssl
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# 安装 wasm32 target + 与本地工具链一致的官方 Trunk 二进制。
RUN rustup target add wasm32-unknown-unknown \
    && case "${TARGETARCH}" in \
        amd64) trunk_target=x86_64-unknown-linux-gnu ;; \
        arm64) trunk_target=aarch64-unknown-linux-gnu ;; \
        *) echo "unsupported Docker architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && archive="trunk-${trunk_target}.tar.gz" \
    && curl -fsSLO "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/${archive}" \
    && curl -fsSLO "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/${archive}.sha256" \
    && printf '%s  %s\n' "$(cat "${archive}.sha256")" "${archive}" | sha256sum --check - \
    && tar -xzf "${archive}" -C /usr/local/bin trunk \
    && rm -f "${archive}" "${archive}.sha256" \
    && trunk --version

# shared-types 从根 workspace 继承 package/dependency 配置，构建上下文必须
# 保留完整 workspace 元数据；frontend 本身仍由独立 Cargo.toml 构建。
COPY Cargo.toml Cargo.lock* ./
COPY rust-toolchain.toml ./
COPY scripts/build_frontend_css.sh ./scripts/build_frontend_css.sh
COPY crates ./crates
COPY shared-types ./shared-types
COPY frontend ./frontend

WORKDIR /build/frontend
RUN --mount=type=cache,id=crossline-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=crossline-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=crossline-frontend-target,target=/build/frontend/target,sharing=locked \
    --mount=type=cache,id=crossline-trunk-cache,target=/root/.cache/trunk,sharing=locked \
    trunk build --release=true

# 阶段 2：nginx 静态服务 + 反代 API
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/frontend/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
